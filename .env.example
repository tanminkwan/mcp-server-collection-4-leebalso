# 모든 MCP 서버 공통 — AI Agent 에게 돌려줄 응답의 최대 크기(UTF-8 바이트).
# 한도를 넘으면 응답을 자르지 않고 '너무 커서 줄 수 없다'는 오류를 반환한다.
MCP_MAX_RESPONSE_BYTES=30000

API_BASE_URL=https://app.mwm.local:20443
API_BEARER_TOKEN=your_long_term_token_here
API_SSL_VERIFY=false
# 수신자 이름-이메일 매핑 (선택, JSON 또는 이름:이메일 콤마 구분)
EMAIL_RECIPIENT_MAPPING=홍길동:hong@example.com, 김철수:kim@example.com

# error_rag_mcp — llm-agent RAG API 연동 설정
RAG_API_BASE_URL=http://localhost:28000
# 선택: 현재 llm-agent는 API Key 없이 접근 가능. 인증이 필요해지면 설정.
RAG_API_BEARER_TOKEN=
RAG_API_SSL_VERIFY=false
RAG_COLLECTION_NAME=your_collection_name_here
RAG_DOMAIN_ID=0
# 선택: 벡터/텍스트 매칭 검색 결과 개수 기본값
RAG_VECTOR_SEARCH_LIMIT=3
RAG_TEXT_MATCHING_LIMIT=2
# 선택: 등록 시 source 태그
RAG_SOURCE=error-resolution-report

# config_diff_mcp — WAS/WEB 설정 변경 이력 조회 설정
# 접속 정보는 위의 API_BASE_URL / API_BEARER_TOKEN / API_SSL_VERIFY 를 공유한다.
# 선택: 단일 일자만 지정됐을 때 앞뒤로 확장할 일수 (기본 1일)
DIFF_DATE_PADDING_DAYS=1

# read_server_file_mcp — 서버 파일 읽기 설정
# 접속 정보는 위의 API_BASE_URL / API_BEARER_TOKEN / API_SSL_VERIFY 를 공유한다.
# 선택: 파일 읽기 주문 후 결과 조회까지 권장 대기 시간(초, 기본 30)
READ_SERVER_FILE_RESULT_WAIT_SECONDS=30
